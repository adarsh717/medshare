# ========================================================
# MedShare Environment Configuration
# ========================================================
# Replace with your project details from Supabase Dashboard -> Project Settings -> API
# Note: In production on Vercel, set these in the Project Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Optional: Supabase service role key (SERVER ONLY - NEVER prefix with NEXT_PUBLIC)
# Used only for initial admin provisioning scripts and authorized server tasks.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
